---
import Layout from "../layouts/Layout.astro";
import CFSHero from "../assets/graphic-hero/cfs-hero.svg";
import GraphicHero from "../components/special-blocks/GraphicHero.astro";
import TwoCol from "../components/content-blocks/TwoCol.astro";
import ImageGroup from "../components/content-blocks/ImageGroup.astro";
import InPageNav from "../components/layout/nav/InPageNav.astro";
import KantrowitzPainting from "../assets/images/art-andrea-kantrowitz.jpg";

import Banner from "../components/content-blocks/Banner.astro";
import Accordion from "../components/content-blocks/Accordion.astro";
import Img1 from "../assets/images/cfs-img-1.jpg";
import Img2 from "../assets/images/cfs-img-2.jpg";
import Img3 from "../assets/images/cfs-img-3.jpg";
import BGBlock from "../components/content-blocks/BGBlock.astro";
import BGBlockAlt from "../components/content-blocks/BGBlockAlt.astro";
import { Icon } from "astro-icon/components";
import CFSTable1 from "../content/call-for-submissions/CFSTable1.astro";
import CFSTable2 from "../content/call-for-submissions/CFSTable2.astro";
import CFSTable3 from "../content/call-for-submissions/CFSTable3.astro";

import { getPageContents } from "../cms/getPageContents";
import PaddedContentContainer from "../components/layout/page/PaddedContentContainer.astro";

const pageArticles = await getPageContents("submissions");
---

<Layout title="Call for Submissions">
  <GraphicHero title="Call for Submissions" imgSrc={CFSHero.src} />
  <TwoCol class="no-margin-after">
    <Fragment slot="left">
      <h2>{pageArticles["about"].headline}</h2>
      <Fragment set:html={pageArticles["about"].content} />
    </Fragment>
    <Fragment slot="right">
      <ImageGroup
        src={KantrowitzPainting}
        alt="Painting of a person standing on a cliff looking out over a valley"
        caption="Art by Andrea Kantrowitz"
      />
    </Fragment>
  </TwoCol>
  <InPageNav
    class="no-margin-before"
    width="page"
    items={[
      { label: "Why Contribute", href: "#why-contribute" },
      { label: "How to Contribute", href: "#how-to-contribute" },
      { label: "Submission Guidelines", href: "#submission-guidelines" },
      {
        label: "Lesson Plan Format Options",
        href: "#lesson-plan-format-options",
      },
    ]}
  />

  <PaddedContentContainer>
    <h2>{pageArticles["why-contribute"].headline}</h2>
    <Fragment set:html={pageArticles["why-contribute"].content} />
    <Banner icon="a" color="a"
      >At Earthrise Commons, you are credited for your project contributions!
      Learn more about Creative Commons attributions.</Banner
    >
    <ImageGroup
      src={Img1}
      alt="Fishermen sitting on the beach praying for a benevolent sea"
      caption="Fishermen pray for a benevolent sea. Dublar Island, Bangladesh. Photo Credit: Rodney Dekker / Climate Visuals"
    />
  </PaddedContentContainer>

  <BGBlock starColors={["yellow-500"]}>
    <h2 id="how-to-contribute">How to Contribute</h2>
    <h3>Complete the Google Form</h3>
    <p>
      Please fill out as much of the provided form as you can to submit your
      contribution.
    </p>
    <a href="https://forms.gle/CQKchaLfjDkk8knC8" class="ec-button"
      >Google Form Submission</a
    >

    <Banner icon="a" color="b"
      >Each submission should be concise (500-700 words) and include all
      required sections. We look forward to receiving your submission!</Banner
    >
  </BGBlock>
  <PaddedContentContainer>
    <h2>{pageArticles["submission-guidelines"].headline}</h2>
    <Fragment set:html={pageArticles["submission-guidelines"].content} />

    <Accordion title={pageArticles["suggested-topics"].headline}
      ><Fragment
        set:html={pageArticles["suggested-topics"].content}
      /></Accordion
    >
    <ImageGroup
      src={Img2}
      alt="Mauritanian woman cleaning the solar panels that provide power for her cooperative's water supply"
      caption="In the Fulani village of Hore Mondji, located in southern Mauritania, a women's cooperative uses solar energy to operate the borehole that supplies water to the market garden. Photo credit: Raphael Pouget / Climate Visuals Countdown"
    />
  </PaddedContentContainer>
  <BGBlock starColors={["yellow-500"]}
    ><h2 id="lesson-plan-format-options">Lesson Plan Format Options</h2>
    <p>
      You may submit your Lesson Plan and Resources in whatever format you
      created them, to minimize the amount of work you need to do and to show a
      diversity of approaches to our community.
    </p><p>
      However, if feasible, viable, and desirable, we encourage including a
      lesson plan using the Understanding by Design (UbD) framework. Please use
      the following format, based on this template that you can copy from Google
      Docs.
    </p>
    <a
      href="https://docs.google.com/document/d/10cX_-EWoEL7cK7l97F7lfvycZz9Y_JXO1D-U1o5LjH0/edit?usp=sharing"
      class="ec-button"
      ><Icon name="fa7-brands:google-drive" />Google Docs Template</a
    >
    <Accordion title="Stage 1 - Big Ideas & Essential Questions" group="udl">
      <CFSTable1 />
    </Accordion>
    <Accordion title="Stage 2 - Learning Activities" group="udl">
      <CFSTable2 />
    </Accordion>
    <Accordion
      title="Stage 3 - Performance Tasks & Evidence of Learning"
      group="udl"
    >
      <CFSTable3 />
    </Accordion>
  </BGBlock>
  <TwoCol theme="light">
    <Fragment slot="left"
      ><h2>
        Call for Submissions: SUNY FACT2 Experiential Learning Playbook
      </h2><p>
        This project call for proposals was adapted from the Experiential
        Learning Playbook by the Faculty Advisory Council on Teaching and
        Technology (FACT2) which was shared with a Creative Commons Attribution
        License (CC-BY-NC). Please find the Call for Submissions for the SUNY
        FACT2 Experiential Playbook below.
      </p>
      <a
        href="https://docs.google.com/document/u/0/d/1lLkew6TTXBqBoBiLWzYw2sHU44T18xI4kIZI3IwfGYw"
        class="ec-button">SUNY FACT2 Call for Submissions</a
      ></Fragment
    >
    <Fragment slot="right">
      <ImageGroup
        alt="A young man helps take care of plants in a greenhouse"
        caption="Educational event at Plantation Park Heights Urban Farm in Baltimore, MD, organized by University of Maryland Extension Urban Farmer Field School. USDA/FPAC Photo by Preston Keres"
        src={Img3}
      />
    </Fragment>
  </TwoCol>
</Layout>
