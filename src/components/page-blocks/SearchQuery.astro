---
interface Props {
  query: string;
  page: number;
  types: string[];
  tags: string[];
}
const PAGINATION_SIZE = 12;
const { query, page, types, tags = [] } = Astro.props;
import CardFeed from "./CardFeed.astro";
import Pagination from "./Pagination.astro";
import { lookupTag } from "../../helpers/tagHelpers";
import { loadFromCMS } from "../../cms/loadFromCMS";
import { randomizeArray } from "../../helpers/randomizeArray";
import { Icon } from "astro-icon/components";

const tagFilters = tags
  .map((tag) => {
    return `.filterBy("taxonomy","*=","${tag}")`;
  })
  .join("");

const cmsQuery = query ? `site.search('${query}')` : "site.index.children";
const typeQuery =
  types.length > 0
    ? `.filterBy('intendedTemplate',"in",["${types.join(`", "`)}"])`
    : `.filterBy('intendedTemplate',"in",["article", "chapter", "lesson", "person"])`;
console.log(typeQuery);
const combinedQuery =
  cmsQuery +
  typeQuery +
  tagFilters +
  ".filterBy('title','!*=','HIDDEN-TEST')" +
  ".sortBy('modified','desc')";
// console.log(combinedQuery);
const pageParams = new URLSearchParams("");
pageParams.append("query", query);
pageParams.append("page", (page + 1).toString());

const getPaginationURL = (page: number) => {
  const tempParams = new URLSearchParams("");
  tempParams.append("query", query);
  tempParams.append("page", page.toString());
  return "?" + tempParams.toString();
};

const pages = await loadFromCMS({
  query: combinedQuery,
  select: {
    id: true,
    uuid: true,
    taxonomy: { query: "page.taxonomy.toObject()" },
    // blueprint: true,
    template: {
      query: "page.intendedTemplate",
    },
    // fields for pages
    title: true,
    organizationname: true,
    role: true,
    level: true,
    modified: {
      query: "page.modified('c')",
    },
    hero: {
      query: `page.hero.safeResize(600)`,
      select: ["url", "width", "height"],
    },
    author: {
      query: "page.author.toPage",
      select: ["displayname", "organizationname", "location"],
    },
    location: true,
    // fields for people
    displayname: true,
    photo: {
      query: `page.photo.isNotEmpty ? page.photo.toFile.crop(256,256) : null`,
    },
  },
  pagination: {
    limit: PAGINATION_SIZE,
    page: page,
  },
});
const paginationData = pages.pagination;
const unsortedPages: Array<any> = pages.data;

const startPage = (paginationData.page - 1) * PAGINATION_SIZE + 1;
const endPage = startPage + pages.data.length - 1;
const hasResults = paginationData.total > 0;

const resultsMsg = hasResults
  ? `${paginationData.total} results found. Showing ${startPage} through ${endPage}:`
  : `No results found.`;
---

{query ? <h2>Results for: {query}</h2> : <h2>Explore Earthrise Commons:</h2>}
{
  tags.length > 0 && (
    <p>
      Filtered by:{" "}
      {tags.map((tag) => {
        return (
          <span class="inline-tag">
            {lookupTag(tag).label}{" "}
            <a class="inline-tag-link">
              <span class="visually-hidden">
                Remove tag {lookupTag(tag).label}
              </span>
              <Icon name="fa7-solid:close" class="uc-icon" />
            </a>
          </span>
        );
      })}
    </p>
  )
}
<p>{resultsMsg}</p>
<!-- <pre><code>
  {combinedQuery}</code></pre> -->
<!-- <pre>{JSON.stringify(pages,null,5)}</pre> -->
<CardFeed pageData={unsortedPages} />
{
  hasResults && (
    <Pagination
      current={paginationData.page}
      max={paginationData.pages}
      query={query}
      types={types}
    />
  )
}

<style>
  .inline-tag {
    display: inline-block;
    border: 1px solid var(--color-base-blue-700);
    background-color: var(--color-base-blue-100);
    padding: 0 0.5rem;
    border-radius: 0.5rem;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .inline-tag-link {
    color: var(--color-local-text);
    font-size: 0.75rem;
  }
</style>
