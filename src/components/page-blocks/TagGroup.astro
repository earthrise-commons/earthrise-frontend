---
import { lookupTag } from "../../helpers/tagHelpers";
const { tags = [] }: { tags?: { label: string; value: string }[] } =
  Astro.props;
---

{
  tags.length > 0 && (
    <nav aria-label="Tags" class="tag-group">
      <ul>
        {tags.map((tag) => {
          try {
            const tagObj = lookupTag(tag.label);
            return (
              <li>
                <a class="tag" href={`/tags/${tag.value}`}>
                  {tagObj.label}
                </a>
              </li>
            );
          } catch {
            return (
              <li>
                <a class="tag" href={`/tags/${tag.value}`}>
                  {tag.label}
                </a>
              </li>
            );
          }
        })}
      </ul>
    </nav>
  )
}

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    /* margin-top: 1rem; */
    list-style: none;
  }
  ul {
    padding-left: 0;
  }
  li {
    margin-bottom: 0;
  }
  .tag {
    background-color: var(--color-base-blue-100);
    color: var(--color-base-blue-700);
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    font-size: 0.75rem;
    font-weight: 400;
  }
  a {
    text-decoration: none;
  }
  .tag-group-label {
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
