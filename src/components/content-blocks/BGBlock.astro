---
import { Image } from "astro:assets";
import StarIcon from "../../assets/icons/icon-star.svg";
import type { ImageMetadata } from "astro";

type StarTypes = "none" | "white" | "yellow";

interface Props {
  starType?: StarTypes;
  imgSrc?: ImageMetadata;
}

const { starType = "white", imgSrc = null } = Astro.props;
const getRandomSign = () => {
  return Math.random() < 0.5 ? 1 : -1;
};

const stars = [];
// TODO: better algorithmically generated star placements
for (let i = 0; i < 6; i++) {
  const curStar = {};
  const side = getRandomSign();
  const xPosKeyword = side == 1 ? "left" : "right";
  const xPosValue = -1 * Math.floor(Math.random() * 160 + 40);
  const yPosPercent = Math.floor(Math.random() * 120 - 10);
  const width = Math.floor(Math.random() * 20 + 20);
  const rotation = Math.floor(Math.random() * 360);
  curStar[xPosKeyword] = xPosValue + "px";
  curStar.top = yPosPercent + "%";
  curStar.width = width + "px";
  curStar.transform = `rotate(${rotation}deg)`;
  stars.push(curStar);
}
---

<div class="bg-block theme-dark">
  {imgSrc && <Image class={"bg-block-image"} src={imgSrc} alt="" />}
  <div class="bg-block-content padded-content-container">
    <slot />
    {
      stars.map((star) => {
        return <StarIcon class="star" style={star} />;
      })
    }
  </div>
</div>
<style>
  .bg-block-image {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    object-fit: cover;
    width: 100%;
    height: 100%;
    z-index: 0;
    
  }

  .bg-block {
    background-color: var(--color-local-background);
    color: var(--color-local-text);
    font-weight: 400;
    padding-top: 8rem;
    padding-bottom: 8rem;
    max-width: 100%;
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    overflow: hidden;
    position: relative;
  }
  .bg-block-content {
    position: relative;
    max-width: var(--size-padded-content);
    margin: 0 auto;
    z-index: 10;
    padding
  }
  .bg-block-content::before {
    content: "";
    position: absolute;
    left: -1rem;
    top: -1rem;
    right: -1rem;
    bottom: -1rem;
    background-color: var(--color-local-background);
    opacity: 0.77;
    z-index: -1;
  }

  .star {
    position: absolute;
  }
</style>
